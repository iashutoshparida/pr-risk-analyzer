# Copy to .env; never commit the real file.
# SHA-256 hex digest(s) of API keys accepted by `prrisk serve`.
PRRISK_API_KEY_HASHES=
# Token used by the API to read PRs and post comments (repo read, pull-requests write).
PRRISK_GITHUB_TOKEN=
# Optional, for --llm openai / --llm anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
